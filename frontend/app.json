{
  "expo": {
    "name": "Meu Financeiro",
    "slug": "financas-pessoais-mobile",
    "version": "2.2.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "financasPessoaisIOS",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 74,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.leonardo25.financaspessoaismobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "financas-pessoais",
    "extra": {
      "supabaseUrl": "",
      "supabaseAnonKey": "",
      "meiApiUrl": "",
      "eas": {
        "projectId": "4479cb0b-2661-4ff1-a9ee-b623193aa503"
      }
    },
    "owner": "contabhub",
    "plugins": [
      "expo-web-browser",
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production",
            "default": false
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
